{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "O2 Cloud",
  "version": "0.2.7",
  "identifier": "es.dabi.o2cloud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "O2 Cloud",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cloud.o2online.es https://tile.openstreetmap.org; media-src 'self' https://cloud.o2online.es"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist"
    },
    "resources": [
      "bin/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQjc3NEU1MUREMTQxN0YKUldSL1FkRWQ1WFMzUURsaWZoVG1za3REbzhSN0tRSjJWMFhwNUVwUC9obzQ2bGlnVlc2TjdnT3oK",
      "endpoints": [
        "https://github.com/dcarnicer/o2cloud-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
