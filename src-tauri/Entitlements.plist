<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release builds run with the hardened runtime, which only lets the
	     app read the Photos library (Fotos view, uploads from Photos) with
	     this entitlement, on top of the user's permission. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
